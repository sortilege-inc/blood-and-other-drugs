# Local Claude Code state
.claude/*
!.claude/launch.json
__pycache__/
build/__pycache__/
# a campaign is an instance, not part of the engine (see PLAN.md); keep any local one out
campaigns/
node_modules/
.wrangler/
# the instance's project skills are tracked (upstream ignores all of .claude/*)
!.claude/skills/
# the campaign's Foundry exports are kept, but never its relay key
campaign/source/**/*.key
